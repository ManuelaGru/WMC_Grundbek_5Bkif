function calculate(num1, num2, operator) {
    switch (operator) {
        case "+":
            return num1 + num2;
        case "-":
            return num1 - num2;
        case "*":
            return num1 * num2;
        case "/":
            if (num2 === 0) return "Division durch 0 nicht erlaubt";
            return num1 / num2;
        default:
            return "Unbekannter Operator";
    }
}

// Eingabe
let num1 = Number(prompt("Erste Zahl:"));
let operator = prompt("Operator (+ - * /):");
let num2 = Number(prompt("Zweite Zahl:"));

// Ausgabe
alert("Ergebnis: " + calculate(num1, num2, operator));
